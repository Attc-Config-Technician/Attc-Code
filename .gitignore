# Local build output and media scratch space
.work/
ad/
build/
dist/
*.idsig
*.log

# Signing material — never commit
*.keystore
*.jks
keystore.properties

# IDE / Gradle leftovers (the project builds without Gradle)
.gradle/
.idea/
*.iml
local.properties
captures/
.externalNativeBuild/
.cxx/

# OS noise
.DS_Store
Thumbs.db

# APKs are tracked only in the two intended places:
#   releases/       — GitHub Release asset source
#   docs/assets/    — direct download from the Pages site
!releases/*.apk
!docs/assets/*.apk

# Generated at build time (see tools/make_certs.sh and tools/pty.sh)
app/assets/tls/
app/jni/libpty.so
