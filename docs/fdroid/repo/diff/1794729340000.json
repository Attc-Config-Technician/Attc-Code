{"repo": {"timestamp": 1795179016000}, "packages": {"com.attc.opencode": {"metadata": {"lastUpdated": 1795172983000, "description": {"en-US": "Attc Code boots a real Ubuntu 24.04 arm64 userland on Android with proot\nand runs AI coding CLIs inside it. No root access is required.\n\nChoose a CLI on every cold start: opencode with Zen models, Claude Code,\nAntigravity, Codex, Kimi Code, or a plain Ubuntu terminal. Every CLI keeps\nits own PTY and window, and the drawer at the top left switches between\nsessions or opens another one.\n\nWith the optional offline voice assistant, say \"Hey Attc\" even while the\nscreen is off. The wake word is a personal on-device model built from three\nrecordings; the recognised Turkish sentence is typed into the active CLI,\nwith Antigravity as the default target.\nShizuku is optional and only adds the phone-control bridge.\n"}}, "versions": {"1e39c521cf149dad0049c915a3ab181ad90ec90fc52ee99577b734ce0758b6c4": null, "1aa92dba7375b70ca6b876eced5eb4d85abbce0b11e8e22a139ad9b83a5b50cf": {"added": 1795172983000, "file": {"name": "/com.attc.opencode_89.apk", "sha256": "1aa92dba7375b70ca6b876eced5eb4d85abbce0b11e8e22a139ad9b83a5b50cf", "size": 461010}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "5.20.0", "versionCode": 89, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 28}, "signer": {"sha256": ["791435ce1087c7841019c82429d1f333dc9c95bb2aa0f24e55594b1d43f72a85"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.CHANGE_NETWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.MODIFY_AUDIO_SETTINGS"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"}, {"name": "android.permission.POST_NOTIF